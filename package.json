{
  "name": "onens-booking-demo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "DARK_MODE=media expo start --android",
    "ios": "DARK_MODE=media expo start --ios",
    "ios-device": "DARK_MODE=media expo run:ios --device",
    "production:ios-device": "DARK_MODE=media expo run:ios --configuration Release --device",
    "build:dev": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform ios --profile preview",
    "build:production": "eas build --platform ios --profile production",
    "web": "DARK_MODE=media expo start --web",
    "lint": "expo lint",
    "doctor": "npx expo-doctor@latest",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "format:tailwind": "npx prettier --write \"**/*.{js,jsx,ts,tsx}\" --plugin=prettier-plugin-tailwindcss"
  },
  "dependencies": {
    "@expo/html-elements": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/actionsheet": "^0.2.53",
    "@gluestack-ui/button": "^1.0.14",
    "@gluestack-ui/checkbox": "^0.1.39",
    "@gluestack-ui/icon": "^0.1.27",
    "@gluestack-ui/input": "^0.1.38",
    "@gluestack-ui/nativewind-utils": "^1.0.28",
    "@gluestack-ui/overlay": "^0.1.22",
    "@gluestack-ui/pressable": "^0.1.23",
    "@gluestack-ui/radio": "^0.1.40",
    "@gluestack-ui/select": "^0.1.31",
    "@gluestack-ui/toast": "^1.0.9",
    "@gluestack-ui/utils": "^3.0.7",
    "@legendapp/motion": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "axios": "^1.11.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "base64-js": "^1.5.1",
    "expo": "^54.0.0",
    "expo-blur": "~15.0.7",
    "expo-brightness": "~14.0.7",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.16",
    "expo-font": "~14.0.9",
